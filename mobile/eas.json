{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8000/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://edutracker-production-cf18.up.railway.app/api",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "pending_setup",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "pending_setup"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://edutracker-production-cf18.up.railway.app/api",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "pending_setup",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "pending_setup"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
